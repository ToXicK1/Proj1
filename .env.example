# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# No real credentials belong in this file.

APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=postgresql+psycopg://aidlc:aidlc@localhost:5432/aidlc
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=aidlc-artifacts
OBJECT_STORE_ACCESS_KEY=change-me
OBJECT_STORE_SECRET_KEY=change-me

# Envelope-encryption key-encryption key (development only; production uses a KMS)
SECRET_ENCRYPTION_KEK=change-me-base64-32-bytes

# AI provider credentials are NOT configured here.
# They are entered by an organization administrator in the platform and stored encrypted.
