# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Every variable here is read by backend/app/core/config.py (prefix AIDLC_).

AIDLC_APP_ENV=development
# Required outside development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIDLC_SECRET_KEY=change-me-to-a-long-random-value
AIDLC_PUBLIC_BASE_URL=http://localhost:5173
AIDLC_COOKIE_SECURE=false

# Used only when running the API outside Docker Compose.
# Compose sets its own database URL for the api service.
AIDLC_DATABASE_URL=postgresql+pg8000://aidlc:aidlc@localhost:5432/aidlc

# AI provider credentials are NOT configured here.
# They are entered by an organization administrator in the platform and stored encrypted (not built yet).

# Object storage (S3 API). Compose gives these to the storage server and the platform; both must match.
# Generate each with: python -c "import secrets; print(secrets.token_hex(20))"
AIDLC_STORAGE_ACCESS_KEY=
AIDLC_STORAGE_SECRET_KEY=
